%% chappe: the SIP/media platform umbrella. Each app under apps/ carries its
%% own deps and, for chappe_sip, the sofia-sip C build hook, and is published
%% to Hex on its own. An app declares the siblings it needs at runtime as
%% default-profile Hex deps with `~>' pins (chappe_mrf on chappe_sip,
%% chappe_esl and chappe_audio); inside the umbrella rebar3 resolves them to
%% the local apps, never from Hex. Optional siblings (the ones chappe_sip
%% starts on demand) are not deps. Releasing: docs/contributing/releasing.md.
%% Older OTP 29 releases have TLS CVEs (CVE-2026-89422 before 29.1.1,
%% CVE-2026-105236 before 29.1.2).
{minimum_otp_vsn, "29.1.2"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{project_app_dirs, ["apps/*"]}.

%% rebar3_hex is pinned: 7.3.0 with hex_core 0.19.0 crashes on publish (a
%% badmatch on cli_auth_callbacks); 7.2.0 resolves hex_core 0.18.0. Each
%% app pins it too, as each is published from its own directory.
{project_plugins, [
    {rebar3_hex, "7.2.0"},
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

{erlfmt, [
    {print_width, 80},
    {files, [
        "apps/*/src/**/*.{erl,hrl,app.src}",
        "apps/*/include/*.hrl",
        "apps/*/bench/*.erl",
        "apps/*/rebar.config",
        "scripts/*.escript",
        "rebar.config"
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, ssl, livery, ws, ra]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

%% The chappe_sip facade is for apps: no module of the stack calls it, it
%% calls the module that owns the concept.
{xref_queries, [
    {"(ME | \"chappe_sip_.*\" : Mod) || chappe_sip : Mod", []}
]}.

{profiles, [
    %% test/ holds the umbrella's own tests (the doc snippet check, the
    %% compliance generator's), run by rebar3 eunit with every app's;
    %% scripts/compliance is the generator scripts/compliance.escript runs
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {extra_src_dirs, [
            {"test", [{recursive, false}]},
            {"scripts/compliance", [{recursive, false}]}
        ]},
        %% one surefire XML per module, read by `make compliance' for the
        %% `%% req:' claims in *_tests.erl
        {eunit_opts, [
            {report, {eunit_surefire, [{dir, "_build/test/logs/eunit"}]}}
        ]}
    ]}
]}.

{shell, [
    {config, "apps/chappe_sip/config/sys.config"},
    {apps, [
        chappe_sip,
        chappe_rtpengine,
        chappe_esl,
        chappe_mix,
        chappe_audio,
        chappe_cluster,
        chappe_mrf
    ]}
]}.
