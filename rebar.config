%% chappe: the SIP/media platform umbrella. Apps under apps/ reference each
%% other by name (no fetched cross-deps); each app carries its own deps and,
%% for chappe_sip, the sofia-sip C build hook. Published to hex per app.
%% Older OTP 29 releases have TLS CVEs (CVE-2026-89422 before 29.1.1,
%% CVE-2026-105236 before 29.1.2).
{minimum_otp_vsn, "29.1.2"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{project_app_dirs, ["apps/*"]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

{erlfmt, [
    {print_width, 80},
    {files, [
        "apps/*/src/**/*.{erl,hrl,app.src}",
        "apps/*/include/*.hrl",
        "apps/*/bench/*.erl",
        "apps/*/rebar.config",
        "rebar.config"
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, ssl, livery, ws, ra]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

%% The chappe_sip facade is for apps: no module of the stack calls it, it
%% calls the module that owns the concept.
{xref_queries, [
    {"(ME | \"chappe_sip_.*\" : Mod) || chappe_sip : Mod", []}
]}.

{profiles, [
    %% test/ holds the umbrella's own tests (the doc snippet check, the
    %% compliance generator's), run by rebar3 eunit with every app's;
    %% scripts/compliance is the generator scripts/compliance.escript runs
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {extra_src_dirs, [
            {"test", [{recursive, false}]},
            {"scripts/compliance", [{recursive, false}]}
        ]}
    ]}
]}.

{shell, [
    {config, "apps/chappe_sip/config/sys.config"},
    {apps, [
        chappe_sip,
        chappe_rtpengine,
        chappe_esl,
        chappe_mix,
        chappe_audio,
        chappe_cluster,
        chappe_mrf
    ]}
]}.
