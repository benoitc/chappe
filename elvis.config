%% Merged lint config for the umbrella: one ruleset over apps/*/src, with the
%% per-module ignores from the three apps combined (module names are unique).
[
    {config, [
        #{
            files => ["apps/*/src/**/*.erl"],
            rules => [
                {elvis_style, no_macros, disable},
                {elvis_style, atom_naming_convention, #{
                    regex => "^[a-z](_?[a-zA-Z0-9]+)*(_SUITE)?$"
                }},
                {elvis_text_style, max_line_length, #{limit => 90}},
                {elvis_style, prefer_strict_generators, disable},
                {elvis_style, prefer_sigils, disable},
                {elvis_style, consistent_ok_error_spec, disable},
                {elvis_style, abc_size, disable},
                {elvis_style, code_complexity, disable},
                {elvis_style, consistent_variable_naming, disable},
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, param_pattern_matching, disable},
                {elvis_style, no_used_ignored_variables, disable},

                %% chappe_mrf_conf keeps its #state{} in chappe_mrf_conf.hrl,
                %% shared with its backends and their helpers;
                %% chappe_sip_dialog_fsm its gen_statem #data{} in
                %% chappe_sip_dialog_fsm.hrl, shared with its helpers;
                %% chappe_sip_subscriber, chappe_sip_publisher and
                %% chappe_sip_regc keep their gen_statem data in a map, chappe_sip_siprec
                %% its gen_server state; chappe_esl_conn and
                %% chappe_esl_node name their gen_statem data #data{}
                %% chappe_sip_uac_fsm names its data #data{}, the gen_statem
                %% convention, in chappe_sip_uac_fsm.hrl for its helpers
                {elvis_style, state_record_and_type, #{
                    ignore => [chappe_sip_registry, chappe_sip_registry_keeper,
                               chappe_sip_dialog_fsm, chappe_sip_engine, chappe_sip_uac_fsm,
                               chappe_sip_ws_listener, chappe_sip_ws_transport,
                               chappe_rtpengine_session, chappe_sip_subscriber,
                               chappe_sip_publisher, chappe_sip_regc,
                               chappe_esl_conn, chappe_esl_node, chappe_mrf_conf,
                               chappe_sip_siprec]
                }},
                %% chappe_sip_focus, chappe_sip_notifier: a watcher's sender
                %% waits on its dialog's monitor, not a clock
                {elvis_style, no_receive_without_timeout, #{
                    ignore => [chappe_sip_b2b, chappe_sip_b2b_relay, chappe_sip_handler,
                               chappe_sip_dialog, chappe_sip_focus, chappe_sip_notifier,
                               %% runs a recording session until its dialog ends
                               chappe_sip_siprec_srs,
                               %% waits on its mover's DOWN, which always comes
                               chappe_mix_move]
                }},
                %% chappe_esl_conn runs the outbound handler module the
                %% listener was started with; chappe_audio_conn and
                %% chappe_audio_stream call the ws_transport module (tcp or
                %% tls) of the connection they hold; chappe_audio_store_srv
                %% chappe_audio_writer and chappe_audio_adopt call the configured
                %% store backend;
                %% chappe_audio_rtp writes to the store module the app
                %% configured; chappe_sip_engine_backend calls the engine
                %% backend (engine_mod) and the registered forwarder
                {elvis_style, no_invalid_dynamic_calls, #{
                    ignore => [chappe_sip_engine, chappe_sip_engine_backend,
                               chappe_esl_conn,
                               chappe_audio_conn, chappe_audio_stream,
                               chappe_audio_store_srv, chappe_audio_writer,
                               chappe_audio_adopt, chappe_audio_rtp,
                               %% a room calls its backend module
                               %% (chappe_mrf_conf_backend)
                               chappe_mrf_conf, chappe_mrf_conf_transfer,
                               chappe_mrf_conf_refer]
                }},
                {elvis_style, simplify_anonymous_functions, #{
                    ignore => [chappe_sip_engine]
                }},
                {elvis_style, generic_type, #{ignore => [chappe_sip, chappe_sip_middleware]}},
                {elvis_style, no_throw, #{ignore => [chappe_rtpengine_bencode]}},
                %% room() is the room's #state{}: the backends of chappe_mrf
                %% read the record, another app's use the room API
                {elvis_style, private_data_types, #{
                    ignore => [chappe_mrf_conf_backend]
                }},
                %% chappe_sip, chappe_sip_media and chappe_esl are public
                %% facades: one function per entry point of the API;
                %% chappe_sip_engine is the stack's one gateway to the NIF and
                %% the WS transport. chappe_mrf and chappe_esl_call are the
                %% typed APIs of an endpoint and a channel: one function per
                %% verb of FreeSWITCH
                {elvis_style, no_god_modules, #{
                    limit => 35,
                    ignore => [chappe_sip, chappe_sip_media, chappe_esl, chappe_sip_engine,
                               chappe_mrf, chappe_esl_call]
                }},
                %% gen_statem / transport modules whose length is structural
                %% (one dispatcher, many clauses); erlfmt line-wrapping pushes
                %% a few over the default 500. chappe_sip_hdr keeps every
                %% structured header parser in one place.
                %% chappe_rtpengine_client runs four transports and the UDP
                %% re-resolution in the one process that owns the socket.
                %% chappe_sip_b2b documents every B2BUA option next to the
                %% entry point that takes it.
                {elvis_style, max_module_length, #{
                    ignore => [chappe_sip_engine, chappe_rtpengine_session,
                               chappe_sip_ws_transport, chappe_sip_hdr,
                               chappe_rtpengine_client,
                               chappe_sip_b2b]
                }},
                %% the dialog fsm keeps one flat #data{} for every dialog
                %% kind, read by its chappe_sip_dialog_* helpers; grouping
                %% the fields would trade one record for nested updates in
                %% each of them. Subscription-only state is folded into one
                %% field.
                %% The UAC fsm carries one INVITE through auth, redirect, 420
                %% and 422 retries, PRACK and forked 2xx in one #data{}
                %% (chappe_sip_uac_fsm.hrl, which elvis does not read):
                %% grouping its fields would not make the helpers clearer.
                {elvis_style, max_record_fields, #{
                    ignore => [chappe_sip_dialog_fsm, chappe_sip_uac_fsm]
                }},
                {elvis_style, max_function_length, #{
                    max_length => 60,
                    ignore => [chappe_sip_engine, chappe_sip_digest,
                               chappe_sip_ws_transport,
                               chappe_rtpengine_session, chappe_rtpengine_client]
                }},
                {elvis_style, max_function_clause_length, #{
                    max_length => 60,
                    ignore => [chappe_sip_digest]
                }},
                {elvis_style, max_anonymous_function_length, #{
                    ignore => [chappe_sip_engine]
                }},
                {elvis_style, max_anonymous_function_clause_length, #{
                    ignore => [chappe_sip_engine]
                }},
                {elvis_style, dont_repeat_yourself, #{
                    ignore => [chappe_sip_handler, chappe_sip_registry,
                               chappe_sip_engine, chappe_sip_digest, chappe_sip_msg,
                               chappe_sip_ws_transport, chappe_rtpengine_session]
                }}
            ],
            ruleset => erl_files_strict
        },
        #{
            files => ["apps/*/include/*.hrl"],
            ruleset => hrl_files
        },
        #{
            files => ["apps/*/rebar.config", "rebar.config"],
            ruleset => rebar_config
        }
    ]}
].
