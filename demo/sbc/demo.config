%%
%% The demo SBC's settings (demo_sbc:start/1 reads this term). DEMO_IP,
%% DEMO_SIP_PORT, DEMO_WS_PORT and DEMO_HTTP_PORT in the environment win
%% over ip, sip_port, ws_port and http_port.
%%
%% TEST-ONLY passwords: change them before the demo leaves your machine.
#{
    %% the address softphones reach the node at
    ip => "127.0.0.1",
    sip_port => 5060,
    ws_port => 5066,
    http_port => 5067,
    realm => <<"chappe.demo">>,
    %% the domains users register under (the ip is always one)
    domains => [<<"chappe.demo">>, <<"localhost">>],
    users => [
        {<<"alice">>, <<"alice-demo">>},
        {<<"bob">>, <<"bob-demo">>}
    ],
    %% two endpoints both in one of these networks talk directly
    networks => [<<"192.168.0.0/16">>, <<"10.0.0.0/8">>],
    %% rtpengine from docker-compose.yml, its NG port published on the host
    rtpengine => #{name => demo_rtpe, host => "127.0.0.1", port => 22223},
    %% kept alive with OPTIONS; Kamailio's dispatcher pings us back
    peers => [
        {kamailio, #{uri => <<"sip:127.0.0.1:15070">>, group => kamailio,
                     interval_ms => 5000}},
        {fs1, #{uri => <<"sip:127.0.0.1:15081">>, group => fs, priority => 1,
                interval_ms => 2000, timeout_ms => 1000}},
        {fs2, #{uri => <<"sip:127.0.0.1:15082">>, group => fs, priority => 2,
                interval_ms => 2000, timeout_ms => 1000}}
    ],
    %% the FreeSWITCH pool of docker-compose.yml: chappe_esl nodes (ESL
    %% published on 127.0.0.1) and, under the same names, chappe_sip peers
    extensions => [<<"1000">>, <<"1001">>, <<"1002">>],
    fs_nodes => [
        {fs1, #{host => "127.0.0.1", port => 18031,
                sip_uri => <<"sip:127.0.0.1:15081">>,
                heartbeat_interval_ms => 1000, probe_interval_ms => 2000,
                backoff_max_ms => 5000}},
        {fs2, #{host => "127.0.0.1", port => 18032,
                sip_uri => <<"sip:127.0.0.1:15082">>,
                heartbeat_interval_ms => 1000, probe_interval_ms => 2000,
                backoff_max_ms => 5000}}
    ],
    %% dialled users that are not registered users
    routes => [
        {<<"kamailio">>, <<"sip:kamailio@127.0.0.1:15070">>}
    ]
}.
