{application, chappe_audio, [
    {description,
        "Audio intake for FreeSWITCH audio forks, and a recording store"},
    {vsn, "0.1.0"},
    {registered, [
        chappe_audio_sup,
        chappe_audio_registry,
        chappe_audio_store_srv,
        chappe_audio_writer_sup,
        chappe_audio_listener_sup,
        chappe_audio_conn_sup,
        chappe_audio_stream_sup,
        chappe_audio_listener
    ]},
    {mod, {chappe_audio_app, []}},
    {applications, [kernel, stdlib, crypto, ws]},
    {env, [
        {storage, #{backend => file, dir => "recordings"}}
    ]},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
