%% Older OTP 29 releases have TLS CVEs (CVE-2026-89422 before 29.1.1,
%% CVE-2026-105236 before 29.1.2).
{minimum_otp_vsn, "29.1.2"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% erlang_ws speaks the WebSocket protocol (RFC 6455) of the sink: the hex
%% package is erlang_ws, the app and modules are named ws. Pure Erlang,
%% OTP-only runtime deps, as chappe_rtpengine takes it (decision 0003).
{deps, [
    {ws, "~> 0.5.0", {pkg, erlang_ws}}
]}.

{shell, [
    {apps, [chappe_audio]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% HTML documentation: `rebar3 ex_doc` renders the guides and the API
%% reference into doc/ (git-ignored; open doc/index.html).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/guides/fork.md">>,
        <<"docs/guides/record.md">>,
        <<"docs/configuration.md">>,
        <<"docs/design/overview.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/guides/fork.md">>,
            <<"docs/guides/record.md">>,
            <<"docs/configuration.md">>
        ]},
        {<<"Reference">>, [<<"docs/design/overview.md">>]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [chappe_audio, chappe_audio_store]},
        {<<"Store backends">>, [chappe_audio_store_file]}
    ]}
]}.

{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
