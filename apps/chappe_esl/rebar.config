{erl_opts, [debug_info, warnings_as_errors]}.

%% Leaf library: no runtime dependencies. Event JSON is decoded with the
%% OTP `json' module (stdlib on OTP 27+).
{deps, []}.

{shell, [
    {apps, [chappe_esl]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% HTML documentation (ex_doc): `rebar3 ex_doc' renders the guides + API
%% reference into doc/ (git-ignored; open doc/index.html). The extras are the
%% docs/ tree; module docs come from specs (comments are markdown, not edoc).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe_esl">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/guides/getting-started.md">>,
        <<"docs/guides/inbound.md">>,
        <<"docs/guides/outbound.md">>,
        <<"docs/guides/events.md">>,
        <<"docs/guides/nodes.md">>,
        <<"docs/guides/select-node.md">>,
        <<"docs/guides/testing.md">>,
        <<"docs/features.md">>,
        <<"docs/design/overview.md">>,
        <<"docs/design/leaf-library-contract.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/guides/getting-started.md">>,
            <<"docs/guides/inbound.md">>,
            <<"docs/guides/outbound.md">>,
            <<"docs/guides/events.md">>,
            <<"docs/guides/nodes.md">>,
            <<"docs/guides/select-node.md">>,
            <<"docs/guides/testing.md">>
        ]},
        {<<"Reference">>, [
            <<"docs/features.md">>,
            <<"docs/design/overview.md">>,
            <<"docs/design/leaf-library-contract.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [chappe_esl]},
        {<<"Connection">>, [chappe_esl_conn, chappe_esl_inbound]},
        {<<"Outbound">>, [
            chappe_esl_outbound_sup, chappe_esl_listener, chappe_esl_handler
        ]},
        {<<"Nodes">>, [chappe_esl_nodes, chappe_esl_node]},
        {<<"Protocol">>, [chappe_esl_parser, chappe_esl_event]}
    ]}
]}.

%% Formatting (erlfmt). Elvis enforces a 90-column limit; erlfmt is kept at 80
%% so formatted code stays under it. Run `rebar3 fmt' to format,
%% `rebar3 fmt --check' to verify.
{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

%% Type checking.
{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, all_deps}
]}.

%% Cross-reference analysis.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
