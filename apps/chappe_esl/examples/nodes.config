%%
%% The two FreeSWITCH nodes of apps/chappe_esl/interop/docker-compose.yml,
%% registered when chappe_esl starts. Ports follow FS1_ESL_PORT and
%% FS2_ESL_PORT only if you edit them here too.
[
    {kernel, [{logger_level, notice}]},
    {chappe_esl, [
        {nodes, [
            {fs1, #{
                host => "127.0.0.1",
                port => 18021,
                tags => [a],
                sip_uri => <<"sip:fs1:5080">>,
                heartbeat_interval_ms => 1000,
                probe_interval_ms => 2000,
                backoff_max_ms => 5000
            }},
            {fs2, #{
                host => "127.0.0.1",
                port => 18022,
                tags => [b],
                sip_uri => <<"sip:fs2:5080">>,
                heartbeat_interval_ms => 1000,
                probe_interval_ms => 2000,
                backoff_max_ms => 5000
            }}
        ]}
    ]}
].
