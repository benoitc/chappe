{application, chappe_esl, [
    {description, "FreeSWITCH Event Socket (ESL) client for Erlang/OTP"},
    {vsn, "0.2.0"},
    {registered, [
        chappe_esl_sup,
        chappe_esl_outbound_sup,
        chappe_esl_nodes,
        chappe_esl_nodes_pg
    ]},
    {mod, {chappe_esl_app, []}},
    {applications, [kernel, stdlib]},
    {env, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/chappe"}]},
    {files, [
        "src",
        "rebar.config",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "NOTICE"
    ]}
]}.
