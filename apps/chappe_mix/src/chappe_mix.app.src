{application, chappe_mix, [
    {description, "RTP audio conference mixer"},
    {vsn, "0.1.0"},
    {registered, [chappe_mix_sup, chappe_mix_conf_sup]},
    {mod, {chappe_mix_app, []}},
    {applications, [kernel, stdlib, crypto]},
    {env, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/chappe"}]},
    {files, [
        "src",
        "rebar.config",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ]}
]}.
