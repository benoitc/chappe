{erl_opts, [debug_info, warnings_as_errors]}.

%% An orchestration app: it drives chappe_sip (signalling), chappe_esl
%% (FreeSWITCH) and, through chappe_sip_media, chappe_rtpengine and
%% chappe_mix. Those are sibling apps of the umbrella, not fetched deps.
{deps, []}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"}
]}.

{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
