%% Older OTP 29 releases have TLS CVEs (CVE-2026-89422 before 29.1.1,
%% CVE-2026-105236 before 29.1.2).
{minimum_otp_vsn, "29.1.2"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% An orchestration app: it drives chappe_sip (signalling), chappe_esl
%% (FreeSWITCH) and chappe_audio (forks and the recording store), the
%% siblings in its `applications'. They are default-profile deps, as Hex
%% reads a package's requirements from the default lock (a dep in another
%% profile is dropped from the tarball); in the umbrella they resolve to
%% the local apps. The `~>' pins follow the siblings' versions: bump them
%% with the sibling. chappe_rtpengine and chappe_mix are reached through
%% chappe_sip_media, and chappe_cluster only with the `cluster' setting
%% chappe_cluster (started on a room's first claim): they are optional,
%% not deps, and a node that uses them adds them itself.
{deps, [
    {chappe_sip, "~> 0.3.0"},
    {chappe_esl, "~> 0.2.0"},
    {chappe_audio, "~> 0.1.0"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_hex, "7.5.0"},
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% `rebar3 hex publish' publishes the docs configured below with the package (and
%% `rebar3 hex publish doc' the docs of a version already on Hex).
{hex, [{doc, #{provider => ex_doc}}]}.

%% HTML documentation: `rebar3 ex_doc` renders the guides and the API
%% reference into doc/ (git-ignored; open doc/index.html).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        {<<"docs/README.md">>, #{
            filename => <<"docs-index">>, title => <<"Documentation index">>
        }},
        {<<"docs/compliance.md">>, #{filename => <<"compliance-matrix">>}},
        {<<"docs/compliance/README.md">>, #{
            filename => <<"compliance-catalogue">>,
            title => <<"Compliance catalogue">>
        }},
        <<"docs/guides/ivr-menu.md">>,
        <<"docs/guides/bridge.md">>,
        <<"docs/guides/conference.md">>,
        <<"docs/configuration.md">>,
        <<"docs/drachtio-mapping.md">>,
        <<"docs/features.md">>,
        <<"docs/design/overview.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/guides/ivr-menu.md">>,
            <<"docs/guides/bridge.md">>,
            <<"docs/guides/conference.md">>,
            <<"docs/configuration.md">>,
            <<"docs/drachtio-mapping.md">>
        ]},
        {<<"Reference">>, [
            <<"docs/README.md">>,
            <<"docs/compliance.md">>,
            <<"docs/compliance/README.md">>,
            <<"docs/features.md">>,
            <<"docs/design/overview.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [chappe_mrf, chappe_mrf_conf]},
        {<<"Conferences">>, [
            chappe_mrf_conf_backend,
            chappe_mrf_conf_native,
            chappe_mrf_conf_native_ep,
            chappe_mrf_conf_fs,
            chappe_mrf_conf_fs_join,
            chappe_mrf_conf_refer,
            chappe_mrf_conf_refer_dial,
            chappe_mrf_conf_refer_member,
            chappe_mrf_conf_refer_op,
            chappe_mrf_conf_transfer,
            chappe_mrf_conf_focus
        ]},
        {<<"Cluster rooms">>, [chappe_mrf_conf_cluster, chappe_mrf_conf_move]},
        {<<"Recordings">>, [chappe_mrf_store]},
        {<<"Internal">>, [
            chappe_mrf_endpoint,
            chappe_mrf_esl,
            chappe_mrf_registry,
            chappe_mrf_lib,
            chappe_mrf_app,
            chappe_mrf_sup
        ]}
    ]}
]}.

{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, top_level_deps},
    %% started on first use with the `cluster' setting
    {plt_extra_apps, [chappe_cluster]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
