%% Older OTP 29 releases have TLS CVEs (CVE-2026-89422 before 29.1.1,
%% CVE-2026-105236 before 29.1.2).
{minimum_otp_vsn, "29.1.2"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% An orchestration app: it drives chappe_sip (signalling), chappe_esl
%% (FreeSWITCH) and, through chappe_sip_media, chappe_rtpengine and
%% chappe_mix. Those are sibling apps of the umbrella, not fetched deps.
{deps, []}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% HTML documentation: `rebar3 ex_doc` renders the guides and the API
%% reference into doc/ (git-ignored; open doc/index.html).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/guides/ivr-menu.md">>,
        <<"docs/guides/bridge.md">>,
        <<"docs/guides/conference.md">>,
        <<"docs/configuration.md">>,
        <<"docs/drachtio-mapping.md">>,
        <<"docs/features.md">>,
        <<"docs/design/overview.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/guides/ivr-menu.md">>,
            <<"docs/guides/bridge.md">>,
            <<"docs/guides/conference.md">>,
            <<"docs/configuration.md">>,
            <<"docs/drachtio-mapping.md">>
        ]},
        {<<"Reference">>, [
            <<"docs/features.md">>,
            <<"docs/design/overview.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [chappe_mrf, chappe_mrf_conf]},
        {<<"Internal">>, [
            chappe_mrf_endpoint,
            chappe_mrf_esl,
            chappe_mrf_registry,
            chappe_mrf_conf_native,
            chappe_mrf_conf_fs,
            chappe_mrf_lib
        ]}
    ]}
]}.

{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
