{application, chappe_mrf, [
    {description,
        "Media resource function: IVR, bridging and conferences on "
        "FreeSWITCH, rtpengine and chappe_mix"},
    {vsn, "0.1.0"},
    {registered, [
        chappe_mrf_sup,
        chappe_mrf_registry,
        chappe_mrf_ep_sup,
        chappe_mrf_conf_sup
    ]},
    {mod, {chappe_mrf_app, []}},
    {applications, [kernel, stdlib, chappe_sip, chappe_esl, chappe_audio]},
    %% esl_port: the port of the listener the FreeSWITCH dialplan `socket'
    %% application connects back to (started with the app when set);
    %% esl_ip: the address it listens on (127.0.0.1 unset); esl_allow: the
    %% networks FreeSWITCH connects from, CIDR strings (any peer unset);
    %% shared_dir: #{freeswitch => Dir, local => Dir}, the folder FreeSWITCH
    %% records into as each side sees it (unset: the same path); cluster:
    %% none (default) or chappe_cluster, a room name owned once in the
    %% region (start chappe_cluster before this app); claim_timeout: ms a
    %% room's claim waits (1000)
    {env, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
