[Unit]
Description=enki_sipserver SIP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enki
Group=enki

# NODE_COOKIE (and any NODE_NAME / SIP config) live here, not in the unit.
# The node refuses to boot with the placeholder cookie.
EnvironmentFile=/etc/enki/enki_sipserver.env

# Run the release in the foreground so systemd is the supervisor. The engine's
# hang policy (engine_failure_action=halt) calls erlang:halt(1) if the sofia
# stack wedges, which exits non-zero and triggers the restart below.
ExecStart=/opt/enki_sipserver/bin/enki_sipserver foreground
ExecStop=/opt/enki_sipserver/bin/enki_sipserver stop

Restart=on-failure
RestartSec=2

# SIP needs privileged ports (5060/5061) only if you bind them; prefer a high
# port or grant the capability instead of running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
