# Copy to /etc/enki/enki_sipserver.env (chmod 600, owned by the enki user).

# A real, secret distribution cookie. The node refuses to boot with the
# shipped placeholder. Generate one, e.g.: openssl rand -hex 32
NODE_COOKIE=CHANGE_ME_SET_NODE_COOKIE

# Node name. Distribution is bound to loopback (see config/vm.args.src); expose
# it only behind a firewall. Comment out -name/-setcookie in vm.args to run
# with no distribution at all.
NODE_NAME=enki_sipserver@127.0.0.1
