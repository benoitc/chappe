# LeakSanitizer suppressions for test/asan/run.sh.
#
# LD_PRELOAD puts ASan in every process the run starts, not only the BEAM
# that loads the NIF. A template suppresses a leak when it matches any frame
# (function, source file or module path), so nothing here may match a frame
# that a NIF call stack carries: the BEAM (erts-*/bin/beam.smp, hence the
# anchored /bin/ paths), sofia-sip or chappe_sip_engine_nif.c. A leak
# allocated under the NIF is always reported.

# erts DNS port helper: exits with its last request buffer allocated.
leak:inet_gethost

# Programs rebar3 and the hooks run (cp, sh); coreutils also close stderr
# before LSan reports, so an unsuppressed leak there is a silent abort.
leak:^/usr/bin/
leak:^/bin/

# OTP's crypto NIF: cipher contexts owned by Erlang resources that are still
# alive when the VM halts (rebar3 fetching from hex over TLS).
leak:priv/lib/crypto.so

# erts: the alternate signal stacks of the VM's scheduler and async threads,
# still mapped when beam.smp halts (sys/unix/sys_signal_stack.c).
leak:sys_thread_init_signal_stack

# erts under +Mea min: the BEAM's own memory (binaries, loaded code, its
# tables) comes from malloc through these two and is still in use when the
# VM halts. They also carry what the NIF takes with enif_alloc, which the
# BEAM's allocators hid from LeakSanitizer before +Mea min, so leak checking
# of the NIF is as it was: sofia's and the shim's own malloc stays checked,
# and every enif_alloc'd byte is now checked for use after free and
# overflow.
leak:erts_sys_alloc
leak:erts_sys_realloc

# erlexec, the erl launcher of the peer nodes some suites start: exits with
# its argument copies allocated (erlexec.c, no NIF there).
leak:erlexec
