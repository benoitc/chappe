%% Older OTP 29 releases have TLS CVEs (CVE-2026-89422 before 29.1.1,
%% CVE-2026-105236 before 29.1.2).
{minimum_otp_vsn, "29.1.2"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% Builds sofia-sip (static) and links priv/lib/chappe_sip_engine_nif.so.
%% Stamp file makes re-runs instant. SKIP_ENGINE_BUILD=1 skips the C build
%% entirely (pure Erlang work runs against chappe_sip_engine_fake).
{pre_hooks, [{compile, "c_src/build.sh"}]}.

%% livery (Apache-2.0): its bundled `ws` (erlang_ws) library terminates the
%% SIP-over-WebSocket transport (M14). Pulls a pure-Erlang dep tree plus one
%% NIF (instrument, built with cmake).
%%
%% chappe_rtpengine / chappe_mix are sibling apps in this umbrella (not fetched
%% deps): the media leaf libraries. They are SIP-free and used only through
%% the chappe_sip_media facade; nothing starts them unless `media' is
%% configured (chappe_sip_media:configure/1 starts a configured backend's app
%% on demand through chappe_sip_media_sup:ensure_app/1).
%%
%% chappe_cluster is a sibling app the same way (not a fetched dep, not in
%% `applications'): with the `cluster' setting chappe_cluster, chappe_sip_app
%% starts it before chappe_sip's supervisor, so it stops after chappe_sip (a
%% release lists it as {chappe_cluster, load}); with the default, none,
%% nothing of it runs.
%%
%% chappe_audio is a sibling app too, and an optional application of
%% chappe_sip (`optional_applications' in chappe_sip.app.src): when it is
%% on the node it starts before chappe_sip and runs the RTP receivers of a
%% SIPREC recording server (chappe_sip_siprec_srs) and the default store;
%% without it every recorded stream is refused 488 and the rest of
%% chappe_sip runs as before.
{deps, [
    {livery, {git, "https://github.com/benoitc/livery.git", {tag, "v0.14.1"}}},
    %% the metrics registry (chappe_sip_metrics), also livery's
    {instrument, "2.0.0"},
    %% the node's hybrid logical clock (chappe_sip_hlc), as chappe_cluster
    {hlc, "3.0.4"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [chappe_sip]}
]}.

{relx, [
    %% livery is included but not auto-started (chappe_sip_ws_sup starts it on
    %% demand); the media libs are likewise load-only (chappe_sip_media_sup starts
    %% them on demand); everything else boots with the release.
    {release, {chappe_sip, "0.2.0"}, [
        chappe_sip,
        {livery, load},
        {chappe_rtpengine, load},
        {chappe_mix, load},
        {chappe_cluster, load},
        chappe_audio
    ]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true},
    {dev_mode, true},
    {include_erts, false}
]}.

{profiles, [
    {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% HTML documentation (ex_doc): `rebar3 ex_doc` renders the guides + API
