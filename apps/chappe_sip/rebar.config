{erl_opts, [debug_info, warnings_as_errors]}.

%% Builds sofia-sip (static) and links priv/lib/chappe_sip_engine_nif.so.
%% Stamp file makes re-runs instant. SKIP_ENGINE_BUILD=1 skips the C build
%% entirely (pure Erlang work runs against chappe_sip_engine_fake).
{pre_hooks, [{compile, "c_src/build.sh"}]}.

%% livery (Apache-2.0): its bundled `ws` (erlang_ws) library terminates the
%% SIP-over-WebSocket transport (M14). Pulls a pure-Erlang dep tree plus one
%% NIF (instrument, built with cmake).
%%
%% chappe_rtpengine / chappe_mix are sibling apps in this umbrella (not fetched
%% deps): the media leaf libraries. They are SIP-free and used only through
%% the chappe_sip_media facade; nothing starts them unless `media' is
%% configured (chappe_sip_media:configure/1 starts a configured backend's app
%% on demand through chappe_sip_media_sup:ensure_app/1).
{deps, [
    {livery, {git, "https://github.com/benoitc/livery.git", {tag, "v0.9.1"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [chappe_sip]}
]}.

{relx, [
    %% livery is included but not auto-started (chappe_sip_ws_sup starts it on
    %% demand); the media libs are likewise load-only (chappe_sip_media_sup starts
    %% them on demand); everything else boots with the release.
    {release, {chappe_sip, "0.2.0"}, [
        chappe_sip,
        {livery, load},
        {chappe_rtpengine, load},
        {chappe_mix, load}
    ]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true},
    {dev_mode, true},
    {include_erts, false}
]}.

{profiles, [
    {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% HTML documentation (ex_doc): `rebar3 ex_doc` renders the guides + API
%% reference into doc/ (git-ignored; open doc/index.html). The extras are the
%% docs/ tree; module docs come from specs (comments are markdown, not edoc).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe_sip">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/features.md">>,
        <<"docs/guides/getting-started.md">>,
        <<"docs/guides/answer-calls.md">>,
        <<"docs/guides/originate-calls.md">>,
        <<"docs/guides/b2bua.md">>,
        <<"docs/guides/proxy.md">>,
        <<"docs/guides/registrar.md">>,
        <<"docs/guides/authentication.md">>,
        <<"docs/guides/websocket.md">>,
        <<"docs/guides/tls.md">>,
        <<"docs/guides/reliable-provisionals.md">>,
        <<"docs/guides/subscriptions.md">>,
        <<"docs/guides/session-timers.md">>,
        <<"docs/guides/refer.md">>,
        <<"docs/guides/conference-focus.md">>,
        <<"docs/guides/configuration.md">>,
        <<"docs/guides/deployment.md">>,
        <<"docs/guides/interop-testing.md">>,
        <<"docs/design/overview.md">>,
        <<"docs/design/engine.md">>,
        <<"docs/design/media.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/guides/getting-started.md">>,
            <<"docs/guides/answer-calls.md">>,
            <<"docs/guides/originate-calls.md">>,
            <<"docs/guides/b2bua.md">>,
            <<"docs/guides/proxy.md">>,
            <<"docs/guides/registrar.md">>,
            <<"docs/guides/authentication.md">>,
            <<"docs/guides/websocket.md">>,
            <<"docs/guides/tls.md">>,
            <<"docs/guides/reliable-provisionals.md">>,
            <<"docs/guides/subscriptions.md">>,
            <<"docs/guides/session-timers.md">>,
            <<"docs/guides/refer.md">>,
            <<"docs/guides/conference-focus.md">>,
            <<"docs/guides/configuration.md">>,
            <<"docs/guides/deployment.md">>,
            <<"docs/guides/interop-testing.md">>
        ]},
        {<<"Reference">>, [
            <<"docs/features.md">>,
            <<"docs/design/overview.md">>,
            <<"docs/design/engine.md">>,
            <<"docs/design/media.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [chappe_sip]},
        {<<"Answer / originate">>, [
            chappe_sip_handler, chappe_sip_dialog, chappe_sip_uac
        ]},
        {<<"B2BUA / Proxy">>, [
            chappe_sip_b2b, chappe_sip_proxy, chappe_sip_route
        ]},
        {<<"Media">>, [chappe_sip_media]},
        {<<"WebSocket">>, [
            chappe_sip_ws, chappe_sip_ws_listener, chappe_sip_ws_transport
        ]},
        {<<"Registrar">>, [chappe_sip_registry]},
        {<<"SIP messages">>, [
            chappe_sip_msg,
            chappe_sip_hdr,
            chappe_sip_uri,
            chappe_sip_req,
            chappe_sip_res,
            chappe_sip_digest
        ]}
    ]}
]}.

%% Formatting (erlfmt). Elvis enforces an 80-column limit, so keep erlfmt at
%% the same width. Run `rebar3 fmt` to format, `rebar3 fmt --check` to verify.
{erlfmt, [
    {print_width, 80},
    {files, ["src/**/*.{erl,hrl,app.src}", "include/*.hrl", "rebar.config"]}
]}.

%% Type checking. The NIF is called through erlang:load_nif; crypto/ssl are
%% used by the digest and the TLS interop test.
{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, all_deps},
    %% livery (and its bundled `ws') provide the WS transport API chappe_sip calls;
    %% the media libs are called through chappe_sip_media
    {plt_extra_apps, [crypto, ssl, livery, ws, chappe_rtpengine, chappe_mix]}
]}.

%% Cross-reference analysis.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
