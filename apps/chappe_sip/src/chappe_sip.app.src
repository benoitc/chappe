{application, chappe_sip, [
    {description,
        "SIP application server: drachtio ported to Erlang on sofia-sip"},
    {vsn, "0.2.0"},
    {registered, [chappe_sip_sup, chappe_sip_engine]},
    {mod, {chappe_sip_app, []}},
    %% livery is started lazily by chappe_sip_ws_sup when a WS listener is configured
    %% (chappe_sip:start with a `ws' option), so a UDP/TCP/TLS-only node pays nothing
    %% for the WebSocket dependency tree.
    %% instrument holds the metrics (chappe_sip_metrics); livery renders them
    %% hlc: the node's hybrid logical clock (chappe_sip_hlc)
    %% chappe_audio runs the streams of a SIPREC recording server
    %% (chappe_sip_siprec_srs) and holds the default store; optional, so a
    %% node without it runs everything else
    {applications, [
        kernel, stdlib, crypto, xmerl, instrument, hlc, chappe_audio
    ]},
    {optional_applications, [chappe_audio]},
    {env, []},
    %% chappe_sip is Apache-2.0; the NIF links the vendored sofia-sip, which
    %% is LGPL-2.1-or-later (THIRD_PARTY_LICENSES.md)
    {licenses, ["Apache-2.0", "LGPL-2.1-or-later"]},
    {links, [{"GitHub", "https://github.com/benoitc/chappe"}]},
    %% the Hex package: the NIF is built from c_src by c_src/build.sh
    %% (the vendored sofia-sip, its patches and the shim); the fuzz
    %% harness, the build output and the tests are left out
    {files, [
        "src",
        "include",
        "c_src/build.sh",
        "c_src/prepare_sofia.sh",
        "c_src/pin_autotools_mtimes.sh",
        "c_src/nif",
        "c_src/sofia-patches",
        "c_src/sofia-sip",
        "rebar.config",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "NOTICE",
        "THIRD_PARTY_LICENSES.md"
    ]}
]}.
