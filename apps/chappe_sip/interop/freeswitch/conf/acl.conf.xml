<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!-- Test-only: admit any source. The published ESL port is seen from
         loopback on Docker Desktop and from the bridge gateway on Linux, so a
         portable e2e allows both. Never ship an allow-all ESL ACL. -->
    <list name="enki_any" default="deny">
      <node type="allow" cidr="0.0.0.0/0"/>
    </list>
  </network-lists>
</configuration>
