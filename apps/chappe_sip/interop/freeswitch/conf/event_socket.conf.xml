<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="ClueCon"/>
    <!-- The test connects over the published port; the source is loopback on
         Docker Desktop and the bridge gateway on Linux. enki_any (see the
         mounted acl.conf.xml) admits both. Test-only. -->
    <param name="apply-inbound-acl" value="enki_any"/>
  </settings>
</configuration>
