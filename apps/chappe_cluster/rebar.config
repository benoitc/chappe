%% SPDX-License-Identifier: Apache-2.0

{erl_opts, [debug_info, warnings_as_errors]}.

{minimum_otp_vsn, "29.1.2"}.

%% Ra is RabbitMQ's Raft library: one group per region holds node
%% liveness, leases and a small KV (docs/decisions/0010).
{deps, [
    {ra, "3.2.0"},
    {hlc, "3.0.4"}
]}.

{shell, [
    {apps, [chappe_cluster]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        %% test/lab: the cluster lab's checker, schedule and client
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {deps, [{proper, "1.5.0"}]}
    ]}
]}.

{project_plugins, [
    {rebar3_hex, "7.5.0"},
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% `rebar3 hex publish' publishes the docs configured below with the package (and
%% `rebar3 hex publish doc' the docs of a version already on Hex).
{hex, [{doc, #{provider => ex_doc}}]}.

%% HTML documentation: `rebar3 ex_doc` renders the guide and the API
%% reference into doc/ (git-ignored; open doc/index.html).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/guides/cluster.md">>,
        <<"docs/configuration.md">>,
        <<"docs/features.md">>,
        <<"docs/design/overview.md">>,
        {<<"interop/README.md">>, #{filename => <<"lab">>, title => <<"Lab">>}}
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [<<"docs/guides/cluster.md">>]},
        {<<"Reference">>, [
            <<"docs/configuration.md">>,
            <<"docs/features.md">>,
            <<"interop/README.md">>
        ]},
        {<<"Design">>, [<<"docs/design/overview.md">>]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [chappe_cluster, chappe_cluster_directory]},
        {<<"Directory backends">>, [chappe_cluster_directory_local]},
        {<<"Ownership">>, [
            chappe_cluster_node,
            chappe_cluster_lapse,
            chappe_cluster_watch,
            chappe_cluster_tab
        ]},
        {<<"Consensus">>, [chappe_cluster_machine, chappe_cluster_ra]},
        {<<"Singletons">>, [
            chappe_cluster_singleton, chappe_cluster_singleton_sup
        ]},
        {<<"Internal">>, [
            chappe_cluster_app,
            chappe_cluster_sup,
            chappe_cluster_config
        ]}
    ]}
]}.

{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
