{application, chappe_rtpengine, [
    {description, "Erlang client for the rtpengine NG control protocol"},
    {vsn, "0.1.0"},
    {registered, [
        chappe_rtpengine_sup,
        chappe_rtpengine_pool,
        chappe_rtpengine_dtmf,
        chappe_rtpengine_client_sup,
        chappe_rtpengine_session_sup
    ]},
    {mod, {chappe_rtpengine_app, []}},
    {applications, [kernel, stdlib, crypto, ws]},
    {env, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/chappe"}]},
    {files, [
        "src",
        "rebar.config",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ]}
]}.
