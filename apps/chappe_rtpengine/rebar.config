{erl_opts, [debug_info, warnings_as_errors]}.

%% erlang_ws provides the ws/wss NG transport (pure Erlang, OTP-only
%% runtime deps); the hex package is erlang_ws, the app and modules
%% are named ws.
{deps, [
    {ws, "~> 0.5.0", {pkg, erlang_ws}}
]}.

{shell, [
    {apps, [chappe_rtpengine]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

%% HTML documentation: `rebar3 ex_doc` renders the guides and the API
%% reference into doc/ (git-ignored; open doc/index.html).
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/chappe">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"docs/guides/getting-started.md">>,
        <<"docs/guides/nodes.md">>,
        <<"docs/guides/sessions.md">>,
        <<"docs/guides/media-features.md">>,
        <<"docs/guides/subscriptions.md">>,
        <<"docs/guides/testing.md">>,
        <<"docs/configuration.md">>,
        <<"docs/features.md">>,
        <<"docs/design/overview.md">>,
        <<"docs/design/leaf-library-contract.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/guides/getting-started.md">>,
            <<"docs/guides/nodes.md">>,
            <<"docs/guides/sessions.md">>,
            <<"docs/guides/media-features.md">>,
            <<"docs/guides/subscriptions.md">>,
            <<"docs/guides/testing.md">>,
            <<"docs/configuration.md">>
        ]},
        {<<"Reference">>, [
            <<"docs/features.md">>,
            <<"docs/design/overview.md">>,
            <<"docs/design/leaf-library-contract.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Public API">>, [
            chappe_rtpengine,
            chappe_rtpengine_session,
            chappe_rtpengine_dtmf,
            chappe_rtpengine_sdp,
            chappe_rtpengine_ng,
            chappe_rtpengine_pool
        ]},
        {<<"Internal">>, [
            chappe_rtpengine_client,
            chappe_rtpengine_resolve,
            chappe_rtpengine_ws_handler,
            chappe_rtpengine_bencode,
            chappe_rtpengine_stream
        ]}
    ]}
]}.

{erlfmt, [
    {print_width, 80},
    {files, ["src/*.{erl,app.src}", "test/*.erl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown]},
    {plt_apps, top_level_deps},
    %% ssl for the tls_opts type on the wss transport; public_key and
    %% crypto because ssl's own specs reference their types
    {plt_extra_apps, [ssl, public_key, crypto]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
